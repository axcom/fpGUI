{
  "module": {
    "name": "fp_bridge",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "Fp_bridgeAbility",
    "deviceTypes": [
      "tablet",
      "default"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "name": "Fp_bridgeAbility",
        "srcEntry": "./ets/fp_bridgeability/Fp_bridgeAbility.ets",
        "description": "$string:Fp_bridgeAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:Fp_bridgeAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "minWindowWidth": 10,//（最小宽度）
        "minWindowHeight": 10,//（最小高度）
        //指定实例模式，specified适用于多窗口
        "launchType": "singleton", //"specified",
        // 关键：确保没有强制前台运行的配置冲突
        // 如果需要在后台运行，可能需要配置后台任务
        "backgroundModes": [
          "audioPlayback",
          "location"
          // 注意：普通应用默认不允许纯后台，需申请特定权限或使用后台任务管理
        ],
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "ohos.want.action.home"
            ]
          }
        ]
      }
    ],
    "requestPermissions": [
      /*{
        "name": "ohos.permission.READ_PASTEBOARD",
        "reason": "$string:reason_read_pasteboard",
        "usedScene": {
          "abilities": [
            "Fp_bridgeAbility"
          ],
          "when": "always"
        }
      },*/
      {
        "name": "ohos.permission.READ_WRITE_DOCUMENTS_DIRECTORY",
        "reason": "$string:reason_documents",
        "usedScene": {
          "abilities": [
            "Fp_bridgeAbility"
          ],
          "when": "always"
        }
      },
      {
        "name": "ohos.permission.WINDOW_TOPMOST"
      },
      {
        "name": "ohos.permission.PRINT"
      },
      {
        "name": "ohos.permission.PREPARE_APP_TERMINATE"
      },
      {
        "name": "ohos.permission.STORE_PERSISTENT_DATA"
      },
      {
        "name": "ohos.permission.INTERNET"
      },
      {
        "name": "ohos.permission.CAMERA",
        "reason": "{}",
        "usedScene": {
          "abilities": [
            "Fp_bridgeAbility"
          ],
          "when": "always"
        }
      },
      {
        "name": "ohos.permission.MICROPHONE",
        "reason": "{}",
        "usedScene": {
          "abilities": [
            "Fp_bridgeAbility"
          ],
          "when": "always"
        }
      },
      {
        "name": "ohos.permission.CUSTOM_SCREEN_CAPTURE",
        "reason": "{}",
        "usedScene": {
          "abilities": [
            "Fp_bridgeAbility"
          ],
          "when": "always"
        }
      },
      {
        "name": "ohos.permission.ACCELEROMETER"
      },
      {
        "name": "ohos.permission.GYROSCOPE"
      },
      {
        "name": "ohos.permission.APPROXIMATELY_LOCATION",
        "reason": "{}",
        "usedScene": {
          "abilities": [
            "Fp_bridgeAbility"
          ],
          "when": "always"
        }
      },
      {
        "name": "ohos.permission.LOCATION",
        "reason": "{}",
        "usedScene": {
          "abilities": [
            "Fp_bridgeAbility"
          ],
          "when": "always"
        }
      },
      {
        "name": "ohos.permission.GET_WIFI_INFO",
        "reason": "{}",
        "usedScene": {
          "abilities": [
            "Fp_bridgeAbility"
          ],
          "when": "always"
        }
      },
      {
        "name": "ohos.permission.ACCESS_BLUETOOTH",
        "reason": "{}",
        "usedScene": {
          "abilities": [
            "Fp_bridgeAbility"
          ],
          "when": "always"
        }
      }/*,
      {
        "name": "ohos.permission.GET_FILE_ICON"
      }*/
    ],
    "extensionAbilities": [
      {
        "name": "Fp_bridgeBackupAbility",
        "srcEntry": "./ets/fp_bridgebackupability/Fp_bridgeBackupAbility.ets",
        "type": "backup",
        "exported": false,
        "metadata": [
          {
            "name": "ohos.extension.backup",
            "resource": "$profile:backup_config"
          }
        ]
      }
    ]
  }
}